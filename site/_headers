/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(self), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' https://data.mehiron.app https://*.r2.dev blob: data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# הקבצים שמשתנים בכל פרסום. ברירת המחדל של Pages היא 4 שעות במטמון,
# ואז מבקר חוזר ראה config.js ישן שמצביע על קובץ נתונים של אתמול, או
# app.js ישן מול data.js חדש. אימות ETag בכל טעינה עולה בקשה אחת קטנה.
/config.js
  Cache-Control: public, max-age=0, must-revalidate
/app.js
  Cache-Control: public, max-age=0, must-revalidate
/data.js
  Cache-Control: public, max-age=0, must-revalidate
/styles.css
  Cache-Control: public, max-age=0, must-revalidate
/geo.js
  Cache-Control: public, max-age=0, must-revalidate
/alerts.js
  Cache-Control: public, max-age=0, must-revalidate
/a11y.js
  Cache-Control: public, max-age=0, must-revalidate
/host.js
  Cache-Control: public, max-age=0, must-revalidate
/ocr.js
  Cache-Control: public, max-age=0, must-revalidate
/cities_geo.json
  Cache-Control: public, max-age=0, must-revalidate
/p/page.css
  Cache-Control: public, max-age=0, must-revalidate
